Output ./assets/capslock.gif
Set Shell "zsh"
Set Theme "TokyoNightStorm"
Set FontFamily "CaskaydiaCove Nerd Font"
Set FontSize 20
Set Width 1500
Set Height 900
Set Padding 10
Set TypingSpeed 0.1

Hide
Type@0ms "nvim"
Enter
Type@0ms ":1"
Enter
Type@0ms "0"
Sleep 5.0
Type "i"
Show
Sleep 2.0
Type "abcdefghijk"
Ctrl+L
Type "abcdefghijk"
Ctrl+L
Type "abcdefghijk"
Sleep 3.0
Hide
Type@0ms ":qa!" Enter
